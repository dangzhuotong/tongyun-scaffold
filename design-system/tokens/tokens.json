{
  "version": "0.1.0",
  "shared": {
    "font-sans": "system-ui, -apple-system, \"PingFang SC\", \"Microsoft YaHei\", sans-serif",
    "font-mono": "ui-monospace, \"SF Mono\", Menlo, Consolas, \"PingFang SC\", \"Microsoft YaHei\"",
    "space-1": "4px",
    "space-2": "8px",
    "space-3": "12px",
    "space-4": "16px",
    "space-5": "20px",
    "space-6": "24px",
    "space-8": "32px",
    "radius-control": "8px",
    "radius-card": "12px",
    "radius-panel": "20px",
    "radius-pill": "999px",
    "text-meta": "0.8125rem",
    "text-body": "0.9375rem",
    "text-title": "1.5rem",
    "duration-fast": "100ms",
    "duration-normal": "200ms",
    "duration-slow": "300ms",
    "ease": "cubic-bezier(0.4, 0, 0.2, 1)",
    "control-height": "36px",
    "target-touch": "44px"
  },
  "themes": {
    "paper": {
      "canvas": "#FAFAF8",
      "surface": "#F4EFEA",
      "card": "#FFFFFF",
      "raised": "#FAF8F5",
      "text": "#2D323A",
      "muted": "#5C626B",
      "border": "#EFEBE4",
      "control-border": "#817A70",
      "accent": "#4D7C5D",
      "accent-hover": "#3F684C",
      "on-accent": "#FFFFFF",
      "danger": "#9C3541",
      "success": "#3F684C",
      "shadow": "0 1px 3px #4632140A, 0 4px 12px -2px #4632140F"
    },
    "paper-dark": {
      "canvas": "#121214",
      "surface": "#16171B",
      "card": "#1E1F23",
      "raised": "#252830",
      "text": "#E3E4E6",
      "muted": "#B2B5BD",
      "border": "#FFFFFF14",
      "control-border": "#858891",
      "accent": "#78C496",
      "accent-hover": "#91D3AA",
      "on-accent": "#121214",
      "danger": "#F2A1A9",
      "success": "#91D3AA",
      "shadow": "0 4px 14px #00000040"
    },
    "desktop": {
      "canvas": "#1A1714",
      "surface": "#221F1B",
      "card": "#2A2622",
      "raised": "#342F2A",
      "text": "#F6F0E6",
      "muted": "#C4B8A8",
      "border": "#3E3832",
      "control-border": "#9A8E80",
      "accent": "#A4C48C",
      "accent-hover": "#7EA56A",
      "on-accent": "#1A1714",
      "danger": "#F2A1A9",
      "success": "#C5D7B6",
      "shadow": "none"
    },
    "cloud": {
      "canvas": "#FCF4E1",
      "surface": "#F3E6CC",
      "card": "#FFFBF3",
      "raised": "#FFFFFF",
      "text": "#2C261C",
      "muted": "#5C5144",
      "border": "#E4D3B8",
      "control-border": "#8A7B6A",
      "accent": "#FDC89C",
      "accent-hover": "#E8B888",
      "on-accent": "#2C261C",
      "danger": "#9C3541",
      "success": "#3F5A30",
      "shadow": "none"
    }
  },
  "components": {
    "button-bg": "var(--ty-accent)",
    "button-hover": "var(--ty-accent-hover)",
    "button-text": "var(--ty-on-accent)",
    "input-border": "color-mix(in srgb, var(--ty-text) 18%, var(--ty-card))",
    "card-bg": "var(--ty-card)",
    "input-ring": "color-mix(in srgb, var(--ty-text) 14%, transparent)",
    "input-height": "36px",
    "input-font-size": "14px"
  }
}
